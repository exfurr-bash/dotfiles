{
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.ans"
  },
  "display": {
    "separator": " → ",
    "color": {
      "keys": "cyan",
      "title": "yellow"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "cyan",
      "format": "{1}" // Mostra apenas o nome (ex: "zsh", "bash")
    },
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "locale",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
